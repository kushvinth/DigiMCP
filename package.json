{
  "name": "fijii-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server exposing Digiicampus college data via the fijii SDK",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "fijii-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node scripts/build-vendor.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "smoke": "node test/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fijii": "file:./vendor/fijii",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
