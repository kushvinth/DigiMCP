# Digiicampus JWT — the `user` cookie from the logged-in portal.
# Copy to `.env` (git-ignored) and fill in. Never commit a real token.
DIGII_TOKEN=

# Your institution's portal origin, e.g. https://<your-institute>.digiicampus.com
DIGII_BASE_URL=

# Optional
# DIGII_TIMEZONE=Asia/Kolkata
# DIGII_TIMEOUT_MS=40000
